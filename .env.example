# ==============================================================================
# DUO — AI Relationship Co-Pilot & Emotional Translator
# Environment Variables Configuration Template
# ==============================================================================
# 🔒 SECURITY WARNING:
# Do NOT commit your real secret keys to GitHub!
# Copy this file to '.env.local' and add your actual API keys there:
#   cp .env.example .env.local
#
# '.env.local' is automatically ignored by git via .gitignore to prevent leaks.
# ==============================================================================

# 1. Google Gemini Multimodal Vision API Key (Required for live AI decoding)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Public Application URL (Optional, default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Environment Mode (development / production)
NODE_ENV=development
